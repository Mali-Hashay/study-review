# Copy this file to ".env" and fill in real values.
# .env is ignored by Git - never commit real secrets.

NODE_ENV=development
PORT=4000

# Supabase dashboard -> "Connect" button -> Connection string -> "Session pooler".
# Replace [YOUR-PASSWORD] with your database password.
# Do not add "?sslmode=..." to the URL - SSL is controlled by DATABASE_SSL below.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Supabase requires SSL. Set to "false" only for a local PostgreSQL without SSL.
DATABASE_SSL=true

# Secret key used to sign login tokens (JWT). At least 32 characters, keep it private.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# How long a login stays valid before signing in again ("7d" = 7 days, "12h" = 12 hours).
JWT_EXPIRES_IN=7d

# Invite code required to register. Share it only with people who should have an account.
REGISTRATION_CODE=REPLACE_WITH_YOUR_INVITE_CODE
