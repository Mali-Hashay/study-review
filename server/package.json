{
  "name": "study-review-server",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the weekly study review app",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:test": "node --env-file-if-exists=.env scripts/test-connection.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
